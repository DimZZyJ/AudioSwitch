<Window x:Class="AudioSwitch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:AudioSwitch.Views"
        Title="AudioSwitch"
        Width="1040"
        Height="740"
        MinWidth="880"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI"
        Icon="/Assets/app.ico"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="52"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Background="{StaticResource WindowBrush}"
            BorderBrush="{StaticResource BorderStrongBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Строка заголовка -->
            <Grid Grid.Row="0" Background="{StaticResource TitleBarBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            Margin="14,0,0,0"
                            VerticalAlignment="Center">
                    <Image Source="/Assets/logo.png"
                           Width="22"
                           Height="22"
                           Margin="0,0,9,0"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="AudioSwitch"
                               FontSize="14"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <TextBlock Text="переключение аудиоустройств по горячей клавише"
                               Margin="10,1,0,0"
                               FontSize="11.5"
                               Foreground="{StaticResource MutedBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Margin="0,0,8,0"
                            VerticalAlignment="Top">
                    <Button x:Name="TrayButton"
                            Style="{StaticResource TitleBarButtonStyle}"
                            Content="&#xE921;"
                            ToolTip="Свернуть в трей"
                            Click="OnMinimizeToTrayClick">
                        <shell:WindowChrome.IsHitTestVisibleInChrome>True</shell:WindowChrome.IsHitTestVisibleInChrome>
                    </Button>
                    <Button x:Name="CloseButton"
                            Style="{StaticResource TitleBarButtonStyle}"
                            Content="&#xE8BB;"
                            ToolTip="Закрыть в трей"
                            Click="OnCloseClick">
                        <shell:WindowChrome.IsHitTestVisibleInChrome>True</shell:WindowChrome.IsHitTestVisibleInChrome>
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="7"
                                        Margin="2">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource CloseHoverBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Основной контент -->
            <Grid Grid.Row="1" Margin="16,14,16,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <views:AudioPanel Grid.Column="0"
                                  Title="Устройства вывода"
                                  Subtitle="Динамики и наушники"
                                  Glyph="{StaticResource SpeakerGeometry}"
                                  AccentBrush="{StaticResource OutputAccentBrush}"
                                  DefaultName="{Binding DataContext.OutputDefaultName, RelativeSource={RelativeSource AncestorType=Window}}"
                                  DefaultDescription="{Binding DataContext.OutputDefaultDescription, RelativeSource={RelativeSource AncestorType=Window}}"
                                  Devices="{Binding DataContext.OutputDevices, RelativeSource={RelativeSource AncestorType=Window}}"
                                  Favorites="{Binding DataContext.OutputFavorites, RelativeSource={RelativeSource AncestorType=Window}}"
                                  FavoriteCount="{Binding DataContext.OutputFavoritesCount, RelativeSource={RelativeSource AncestorType=Window}}"
                                  SwitchCommand="{Binding DataContext.SwitchOutputCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                  Hotkey="{Binding DataContext.OutputHotkey, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}" />

                <views:AudioPanel Grid.Column="2"
                                  Title="Устройства ввода"
                                  Subtitle="Микрофоны"
                                  Glyph="{StaticResource MicrophoneGeometry}"
                                  AccentBrush="{StaticResource InputAccentBrush}"
                                  DefaultName="{Binding DataContext.InputDefaultName, RelativeSource={RelativeSource AncestorType=Window}}"
                                  DefaultDescription="{Binding DataContext.InputDefaultDescription, RelativeSource={RelativeSource AncestorType=Window}}"
                                  Devices="{Binding DataContext.InputDevices, RelativeSource={RelativeSource AncestorType=Window}}"
                                  Favorites="{Binding DataContext.InputFavorites, RelativeSource={RelativeSource AncestorType=Window}}"
                                  FavoriteCount="{Binding DataContext.InputFavoritesCount, RelativeSource={RelativeSource AncestorType=Window}}"
                                  SwitchCommand="{Binding DataContext.SwitchInputCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                  Hotkey="{Binding DataContext.InputHotkey, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}" />
            </Grid>

            <!-- Статусная строка -->
            <Border Grid.Row="2"
                    Background="{StaticResource TitleBarBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="16,9">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Ellipse Width="7"
                                 Height="7"
                                 Margin="0,0,9,0"
                                 VerticalAlignment="Center"
                                 Fill="{StaticResource AccentBrush}" />
                        <TextBlock Text="{Binding DataContext.StatusMessage, RelativeSource={RelativeSource AncestorType=Window}}"
                                   ToolTip="{Binding DataContext.StatusMessage, RelativeSource={RelativeSource AncestorType=Window}}"
                                   FontSize="12"
                                   Foreground="{StaticResource MutedBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="620"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal">
                        <CheckBox Content="Запускать с Windows"
                                  Style="{StaticResource ThemeCheckBoxStyle}"
                                  Margin="0,0,14,0"
                                  ToolTip="Добавляет AudioSwitch в автозапуск Windows (раздел Run в реестре)"
                                  IsChecked="{Binding DataContext.StartWithWindows, RelativeSource={RelativeSource AncestorType=Window}}" />
                        <TextBlock Text="Горячие клавиши работают и в трее"
                                   Margin="0,0,14,0"
                                   FontSize="11.5"
                                   Foreground="{StaticResource FaintBrush}"
                                   VerticalAlignment="Center" />
                        <Button Content="Обновить"
                                Style="{StaticResource GhostButtonStyle}"
                                Command="{Binding DataContext.RefreshCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                        <Button Content="Свернуть в трей"
                                Margin="8,0,0,0"
                                Style="{StaticResource GhostButtonStyle}"
                                Click="OnMinimizeToTrayClick" />
                        <Button Content="Выход"
                                Margin="8,0,0,0"
                                Style="{StaticResource GhostButtonStyle}"
                                Command="{Binding DataContext.ExitCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
