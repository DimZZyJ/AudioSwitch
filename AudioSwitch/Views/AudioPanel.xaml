<UserControl x:Class="AudioSwitch.Views.AudioPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:AudioSwitch.Views"
             Foreground="{StaticResource TextBrush}"
             DataContext="{Binding RelativeSource={RelativeSource Self}}">

    <UserControl.Resources>
        <DataTemplate x:Key="DeviceRow">
            <Border x:Name="Row" Style="{StaticResource DeviceRowStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="StarButton"
                            Grid.Column="0"
                            Style="{StaticResource IconButtonStyle}"
                            Width="26"
                            Height="26"
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            Command="{Binding ToggleFavoriteCommand}">
                        <Path x:Name="StarIcon"
                              Data="{StaticResource StarGeometry}"
                              Width="15"
                              Height="15"
                              Stretch="Uniform"
                              Fill="Transparent"
                              Stroke="{StaticResource MutedBrush}"
                              StrokeThickness="1.2"
                              StrokeLineJoin="Round" />
                    </Button>

                    <StackPanel Grid.Column="1"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}"
                                   ToolTip="{Binding Name}"
                                   Style="{StaticResource DeviceNameText}" />
                        <TextBlock Text="{Binding Description}"
                                   FontSize="11"
                                   Style="{StaticResource BodyText}"
                                   Visibility="{Binding Description, Converter={StaticResource StringToVis}}" />
                    </StackPanel>

                    <Border x:Name="ActiveBadge"
                            Grid.Column="2"
                            Style="{StaticResource ActiveBadgeStyle}"
                            Visibility="Collapsed">
                        <TextBlock Text="активно"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ActiveTextBrush}" />
                    </Border>

                    <Button x:Name="ActivateButton"
                            Grid.Column="3"
                            Content="Включить"
                            Style="{StaticResource CompactButtonStyle}"
                            Command="{Binding ActivateCommand}" />
                </Grid>
            </Border>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                    <Setter TargetName="StarIcon" Property="Fill" Value="{StaticResource StarBrush}" />
                    <Setter TargetName="StarIcon" Property="Stroke" Value="{StaticResource StarBrush}" />
                    <Setter TargetName="StarButton" Property="ToolTip" Value="Убрать из избранного" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsFavorite}" Value="False">
                    <Setter TargetName="StarButton" Property="ToolTip" Value="Добавить в избранное" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDefault}" Value="True">
                    <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource ActiveRowBorderBrush}" />
                    <Setter TargetName="ActiveBadge" Property="Visibility" Value="Visible" />
                    <Setter TargetName="ActivateButton" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Border Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="12">
        <Grid Margin="14,13">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Заголовок панели -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0"
                      Width="34"
                      Height="34"
                      Margin="0,0,10,0">
                    <Border Background="{Binding AccentBrush}"
                            Opacity="0.16"
                            CornerRadius="9" />
                    <Path Data="{Binding Glyph}"
                          Width="18"
                          Height="18"
                          Stroke="{Binding AccentBrush}"
                          StrokeThickness="1.6"
                          StrokeLineJoin="Round"
                          Fill="Transparent"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
                </Grid>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}"
                               FontSize="14.5"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" />
                    <TextBlock Text="{Binding Subtitle}"
                               FontSize="11.5"
                               Foreground="{StaticResource MutedBrush}" />
                </StackPanel>

                <Button Grid.Column="2"
                        Content="Переключить"
                        VerticalAlignment="Center"
                        Style="{StaticResource CompactButtonStyle}"
                        ToolTip="Переключить на следующее избранное устройство — то же, что горячая клавиша"
                        Command="{Binding SwitchCommand}" />
            </Grid>

            <!-- Активное устройство -->
            <Border Grid.Row="1"
                    Margin="0,12,0,0"
                    Padding="12,9"
                    Background="{StaticResource CardAccentBrush}"
                    BorderBrush="{StaticResource BorderStrongBrush}"
                    BorderThickness="1"
                    CornerRadius="10">
                <StackPanel>
                    <TextBlock Text="Сейчас используется" Style="{StaticResource SectionLabel}" />
                    <TextBlock Text="{Binding DefaultName}"
                               Margin="0,3,0,0"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding DefaultDescription}"
                               Style="{StaticResource BodyText}"
                               Visibility="{Binding DefaultDescription, Converter={StaticResource StringToVis}}" />
                </StackPanel>
            </Border>

            <!-- Горячая клавиша -->
            <Grid Grid.Row="2" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            VerticalAlignment="Center"
                            Margin="0,0,12,0">
                    <TextBlock Text="Горячая клавиша" Style="{StaticResource SectionLabel}" />
                    <TextBlock Text="Переключает избранные устройства по кругу"
                               Margin="0,2,0,0"
                               Style="{StaticResource BodyText}" />
                </StackPanel>

                <views:HotkeyBox Grid.Column="1"
                                 Width="200"
                                 VerticalAlignment="Center"
                                 Hotkey="{Binding Hotkey, Mode=TwoWay}" />
            </Grid>

            <!-- Списки -->
            <ScrollViewer Grid.Row="3"
                          Margin="0,12,0,0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Избранные (" Style="{StaticResource SectionLabel}" />
                        <TextBlock Text="{Binding FavoriteCount}"
                                   Style="{StaticResource SectionLabel}"
                                   Foreground="{StaticResource MutedBrush}" />
                        <TextBlock Text=")" Style="{StaticResource SectionLabel}" />
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding Favorites}"
                                  ItemTemplate="{StaticResource DeviceRow}"
                                  Margin="0,6,0,0" />

                    <Border Background="#171D26"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="11,10"
                            Margin="0,0,0,4"
                            Visibility="{Binding Favorites, Converter={StaticResource EmptyCollectionToVis}}">
                        <TextBlock Text="Пока пусто. Отметьте звёздочкой нужные устройства в списке ниже."
                                   Style="{StaticResource BodyText}"
                                   TextWrapping="Wrap" />
                    </Border>

                    <TextBlock Text="Все устройства"
                               Style="{StaticResource SectionLabel}"
                               Margin="0,10,0,0" />

                    <ItemsControl ItemsSource="{Binding Devices}"
                                  ItemTemplate="{StaticResource DeviceRow}"
                                  Margin="0,6,0,0" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
